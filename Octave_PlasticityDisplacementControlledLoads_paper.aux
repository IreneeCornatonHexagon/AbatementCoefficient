\@writefile{lof}{\contentsline {figure}{\numberline {28}{\ignorespaces Geometry of Roland Roche's original two-segment bar example: a stepped shaft with a flexible segment of diameter \SI {12}{mm} and length \SI {32}{in} and a stiffer segment of diameter \SI {16}{mm}, clamped at both ends, with the total length (\SI {100}{in}) measured from the flexible end.}}{30}{figure.caption.33}\protected@file@percent }
\newlabel{fig:roche-example-geometry}{{28}{30}{Geometry of Roland Roche's original two-segment bar example: a stepped shaft with a flexible segment of diameter \SI {12}{mm} and length \SI {32}{in} and a stiffer segment of diameter \SI {16}{mm}, clamped at both ends, with the total length (\SI {100}{in}) measured from the flexible end}{figure.caption.33}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {29}{\ignorespaces Numerical worksheet from the source presentation reproducing Roche's two-section example (geometry in Figure~\ref {fig:roche-example-geometry}): the elastic reference stresses ($\Delta \sigma _{0,\mathrm  {weak}}=\SI {440}{MPa}$, $\Delta \sigma _{0,\mathrm  {strong}}=\SI {247}{MPa}$) give local resiliences $t_{\mathrm  {weak}}=1.276$ and $t_{\mathrm  {strong}}=3.855$, combined into a global resilience $T=2.006$ and local elastic follow-up factors $r_{\mathrm  {weak}}=T/t_{\mathrm  {weak}}-1=0.572$ and $r_{\mathrm  {strong}}=\max (0,T/t_{\mathrm  {strong}}-1)=0$; the lower numerical-calculation block solves the same problem with Mathcad solve blocks, confirming $\varphi =0.769$ and $\Delta \sigma =\SI {338.173}{MPa}$ by an independent route.}}{31}{figure.caption.34}\protected@file@percent }
\newlabel{fig:roche-calculation-sheet}{{29}{31}{Numerical worksheet from the source presentation reproducing Roche's two-section example (geometry in Figure~\ref {fig:roche-example-geometry}): the elastic reference stresses ($\Delta \sigma _{0,\mathrm {weak}}=\SI {440}{MPa}$, $\Delta \sigma _{0,\mathrm {strong}}=\SI {247}{MPa}$) give local resiliences $t_{\mathrm {weak}}=1.276$ and $t_{\mathrm {strong}}=3.855$, combined into a global resilience $T=2.006$ and local elastic follow-up factors $r_{\mathrm {weak}}=T/t_{\mathrm {weak}}-1=0.572$ and $r_{\mathrm {strong}}=\max (0,T/t_{\mathrm {strong}}-1)=0$; the lower numerical-calculation block solves the same problem with Mathcad solve blocks, confirming $\varphi =0.769$ and $\Delta \sigma =\SI {338.173}{MPa}$ by an independent route}{figure.caption.34}{}}
