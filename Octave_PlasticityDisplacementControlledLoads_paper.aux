\@writefile{lof}{\contentsline {figure}{\numberline {25}{\ignorespaces Ramberg--Osgood material data extracted from the presentation. Left: family of 316L(N) stress--strain curves used to justify the temperature-dependent scaling of the law through $R_{p0.2}(T)$. Right: sensitivity check at \SI {500}{\celsius } (a different temperature from the \SI {550}{\celsius } benchmark), comparing the reference parameter set ($C_0=1.198$, $n_0=0.1125$, $C_0R_{p0.2}\approx \SI {131.8}{MPa}$) with the alternative fit ($C_0=1.233$, $n_0=0.130$, $C_0R_{p0.2}\approx \SI {135.6}{MPa}$) discussed in the text. \textcolor {red}{-->show the importance of n0/C0 on the final results } }}{23}{figure.caption.30}\protected@file@percent }
\newlabel{fig:ro-curves}{{25}{23}{Ramberg--Osgood material data extracted from the presentation. Left: family of 316L(N) stress--strain curves used to justify the temperature-dependent scaling of the law through $R_{p0.2}(T)$. Right: sensitivity check at \SI {500}{\celsius } (a different temperature from the \SI {550}{\celsius } benchmark), comparing the reference parameter set ($C_0=1.198$, $n_0=0.1125$, $C_0R_{p0.2}\approx \SI {131.8}{MPa}$) with the alternative fit ($C_0=1.233$, $n_0=0.130$, $C_0R_{p0.2}\approx \SI {135.6}{MPa}$) discussed in the text. \textcolor {red}{-->show the importance of n0/C0 on the final results }}{figure.caption.30}{}}
